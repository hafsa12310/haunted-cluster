# Required. URLs point at the victim stack running locally;
# docker-compose.yml overrides them with container hostnames.
PROMETHEUS_URL=http://localhost:9090
# One <SERVICE>_URL per SERVICE_CHAIN entry (upper-cased, "-" -> "_")
GATEWAY_URL=http://localhost:3000
ORDERS_URL=http://localhost:3001
PAYMENTS_URL=http://localhost:3002

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3100

# Polling
# Upstream -> downstream
SERVICE_CHAIN=gateway,orders,payments
POLL_INTERVAL_MS=2000
# PromQL duration: <number><s|m|h>
RATE_WINDOW=15s
PROMETHEUS_TIMEOUT_MS=1500

# Health thresholds (each OK value must be less than its CRITICAL value)
LATENCY_OK_MS=100
LATENCY_CRITICAL_MS=1000
ERROR_RATIO_OK=0.01
ERROR_RATIO_CRITICAL=0.2
MEMORY_OK_MB=120
MEMORY_CRITICAL_MB=230

# Incidents
OPEN_AFTER_POLLS=2
CLOSE_AFTER_POLLS=3
INCIDENT_HISTORY_LIMIT=50
CHAOS_EVIDENCE_WINDOW_SECONDS=150

# Chaos proxy
CHAOS_PROXY_TIMEOUT_MS=3000
