# Gateway
PORT=3000
ORDERS_URL=http://localhost:3001
DOWNSTREAM_TIMEOUT_MS=5000
CHAOS_TTL_SECONDS=120
# Megabytes per second allocated while the memory-leak chaos is active (slower leak gives the forecaster a longer ramp).
LEAK_MB_PER_SECOND=2
# How often, in milliseconds, each service refreshes its memory gauges (positive integer).
MEMORY_GAUGE_INTERVAL_MS=1000

# Orders
# PORT=3001
PAYMENTS_URL=http://localhost:3002

# Payments
# PORT=3002
# docker compose only: payments container memory limit, also used as memswap_limit (no swap),
# so the leak ends in a real OOM kill and restart. Keep it equal to the engine's MEMORY_LIMIT_MB.
PAYMENTS_MEM_LIMIT=256m
# docker compose only: chaos TTL for payments (seconds). Must outlast the leak's ~110 s
# run to the OOM kill at LEAK_MB_PER_SECOND=2; the other services keep CHAOS_TTL_SECONDS=120.
PAYMENTS_CHAOS_TTL_SECONDS=240

# Load generator
GATEWAY_URL=http://localhost:3000
LOAD_INTERVAL_MS=500
