# Gateway
PORT=3000
ORDERS_URL=http://localhost:3001
DOWNSTREAM_TIMEOUT_MS=5000
CHAOS_TTL_SECONDS=120
# docker compose only: gateway container memory limit, also used as memswap_limit (no swap),
# so a leak ends in a real OOM kill. The kill lands at RSS about 296 MB for 256m; the engine's
# MEMORY_LIMIT_MB (290) is set just below that point.
GATEWAY_MEM_LIMIT=256m
# docker compose only: chaos TTL for gateway (seconds). Must outlast the ~105 s leak run to the
# OOM kill at LEAK_MB_PER_SECOND=2.
GATEWAY_CHAOS_TTL_SECONDS=240
# Megabytes per second allocated while the memory-leak chaos is active (slower leak gives the forecaster a longer ramp).
LEAK_MB_PER_SECOND=2
# How often, in milliseconds, each service refreshes its memory gauges (positive integer).
MEMORY_GAUGE_INTERVAL_MS=1000

# Orders
# PORT=3001
PAYMENTS_URL=http://localhost:3002
# docker compose only: orders memory limit (also memswap_limit) and chaos TTL, same pattern as gateway.
ORDERS_MEM_LIMIT=256m
ORDERS_CHAOS_TTL_SECONDS=240

# Payments
# PORT=3002
# docker compose only: payments container memory limit, also used as memswap_limit (no swap),
# so the leak ends in a real OOM kill and restart. The OOM kill lands at RSS about 296 MB, which the engine's MEMORY_LIMIT_MB (290) tracks.
PAYMENTS_MEM_LIMIT=256m
# docker compose only: chaos TTL for payments (seconds). Must outlast the leak's ~105 s
# run to the OOM kill at LEAK_MB_PER_SECOND=2.
PAYMENTS_CHAOS_TTL_SECONDS=240

# Load generator
GATEWAY_URL=http://localhost:3000
LOAD_INTERVAL_MS=500
