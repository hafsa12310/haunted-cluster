{
  "name": "victim-app",
  "version": "0.1.0",
  "description": "Haunted Cluster victim-app NestJS monorepo",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:gateway": "nest build gateway",
    "build:orders": "nest build orders",
    "build:payments": "nest build payments",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:gateway": "nest start gateway",
    "start:orders": "nest start orders",
    "start:payments": "nest start payments",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --runInBand"
  },
  "dependencies": {
    "@nestjs/axios": "3.0.3",
    "@nestjs/common": "10.3.10",
    "@nestjs/core": "10.3.10",
    "@nestjs/platform-express": "10.3.10",
    "axios": "1.7.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.1.4",
    "@nestjs/testing": "10.3.10",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "fast-check": "3.20.0",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.5.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/observability(|/.*)$": "<rootDir>/libs/observability/src/$1",
      "^@app/chaos(|/.*)$": "<rootDir>/libs/chaos/src/$1"
    }
  }
}
